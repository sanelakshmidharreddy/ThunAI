# ARC (AI Responsive Companion) Environment Configuration

# Application
APP_NAME="ARC - AI Responsive Companion"
APP_VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
# Default: async SQLite for instant local zero-dependency testing
DATABASE_URL="sqlite+aiosqlite:///./arc.db"
# Production / Docker PostgreSQL option:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/arc_db"

# Redis (Optional, supported for background queues & notification jobs)
REDIS_ENABLED=False
REDIS_URL="redis://localhost:6379/0"

# AI / LLM Orchestration (Pydantic AI & LangGraph)
# Options: "auto" | "openai" | "gemini" | "rule_fallback"
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Voice Gateway Providers
# Options: "device" | "whisper" | "sarvam"
VOICE_PROVIDER="device"
SARVAM_API_KEY=""
SARVAM_BASE_URL="https://api.sarvam.ai"

# Languages
SUPPORTED_LANGUAGES=["en", "ta", "hi", "te"]
DEFAULT_LANGUAGE="en"

# Demo Mode & Simulated Geolocation
DEMO_MODE=True
SIMULATED_LOCATION_LAT=13.0827
SIMULATED_LOCATION_LNG=80.2707

# Caregiver Web & CORS
CORS_ORIGINS=["*"]
VITE_API_URL="http://localhost:8000/api/v1"
