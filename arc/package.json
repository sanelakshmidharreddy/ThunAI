{
  "name": "arc-monorepo",
  "version": "1.0.0",
  "description": "ARC — AI Responsive Companion: Voice-first, multilingual elderly assistance and caregiver coordination platform",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
